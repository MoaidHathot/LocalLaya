{
  "name": "local-laya",
  "version": "0.5.0",
  "private": true,
  "description": "PoC, benchmarks, calibration tooling and execution-provider router for Laya (ONNX port, @receptron/laya) on Windows",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ask": "node ask.mjs",
    "ask:sidecar": "node ask.mjs --sidecar",
    "sidecar:start": "node ask.mjs --start",
    "sidecar:status": "node ask.mjs --status",
    "sidecar:stop": "node ask.mjs --stop",
    "serve": "node serve.mjs",
    "poc": "node poc.mjs",
    "poc:webgpu": "node poc.mjs --ep webgpu --fp16 --calibration calibration/smart-home-v3.json",
    "router": "node router-demo.mjs --calibration calibration/smart-home-v3.json",
    "verify-model": "node verify-model.mjs",
    "bench": "node bench.mjs",
    "bench:all": "node bench-all.mjs",
    "calibrate": "node calibrate.mjs --ep webgpu --variant v3",
    "fp16:convert": ".venv/Scripts/python.exe tools/optimize_graph.py models/receptron--laya-onnx/68f27dfe5a27a54fb2b1fefc432f43f972e90868 models/laya-onnx-fp16",
    "fp16:check": "node experiments/ab.mjs --variant fp32=webgpu --variant fp16=webgpu:fp16 --variant cuda=cuda:fp16 --rounds 4",
    "cuda:setup": "node tools/setup-cuda-lane.mjs",
    "cuda:check": "node tools/setup-cuda-lane.mjs --check",
    "test": "node --test test/unit.test.mjs",
    "test:router": "node --test --test-concurrency=1 test/router.test.mjs",
    "test:cuda": "node --test --test-concurrency=1 test/cuda-lane.test.mjs",
    "test:sidecar": "node --test --test-concurrency=1 test/sidecar.test.mjs",
    "test:demo": "node --test --test-concurrency=1 test/demo.test.mjs",
    "demo": "node demo/run-all.mjs",
    "test:all": "node --test test/unit.test.mjs && node --test --test-concurrency=1 test/router.test.mjs && node --test --test-concurrency=1 test/cuda-lane.test.mjs && node --test --test-concurrency=1 test/sidecar.test.mjs && node --test --test-concurrency=1 test/demo.test.mjs"
  },
  "dependencies": {
    "@receptron/laya": "file:vendor/receptron-laya-0.1.2.tgz"
  }
}
